{{- $email := promptStringOnce . "email" "Git commit email" "anan.ara2001@gmail.com" -}}
{{- $name := promptStringOnce . "name" "Git commit name" "Anan A" -}}

# Regenerated by every `chezmoi init` run (e.g. after adding a new prompt
# above), so this has to be part of the template's own output -- anything
# added to the generated chezmoi.toml by other means (a one-off --source
# flag, a manual edit) gets silently dropped on the next regeneration.
sourceDir = "{{ .chezmoi.homeDir }}/dotfiles"

[data]
    email = {{ $email | quote }}
    name  = {{ $name | quote }}
