{{- $email := promptStringOnce . "email" "Git commit email" "anan.ara2001@gmail.com" -}}
{{- $name := promptStringOnce . "name" "Git commit name" "Anan A" -}}

{{- $zsh      := promptBoolOnce . "apps.zsh"       "Deploy zsh config + zsh-autosuggestions/zsh-syntax-highlighting/vivid" true -}}
{{- $git      := promptBoolOnce . "apps.git"       "Deploy git config + git-delta" true -}}
{{- $vim      := promptBoolOnce . "apps.vim"       "Deploy vim config (no packages)" true -}}
{{- $neovim   := promptBoolOnce . "apps.neovim"    "Deploy Neovim (LazyVim) config + neovim/ripgrep/fd" true -}}
{{- $lazygit  := promptBoolOnce . "apps.lazygit"   "Deploy lazygit config + lazygit/git-delta" true -}}
{{- $yazi     := promptBoolOnce . "apps.yazi"      "Deploy yazi config + yazi" true -}}
{{- $herdr    := promptBoolOnce . "apps.herdr"     "Deploy herdr config + herdr" true -}}
{{- $cliTools := promptBoolOnce . "apps.cli_tools" "Install general CLI tools (eza, bat, fzf, zoxide)" true -}}
{{- $ghostty := false -}}
{{- $karabiner := false -}}
{{- if eq .chezmoi.os "darwin" -}}
{{- $ghostty   = promptBoolOnce . "apps.ghostty"   "Deploy Ghostty config + Ghostty/Nerd Font (darwin only)" true -}}
{{- $karabiner = promptBoolOnce . "apps.karabiner" "Deploy Karabiner config + karabiner-elements/goku (darwin only)" true -}}
{{- end -}}

# Regenerated by every `chezmoi init` run (e.g. after adding a new prompt
# above), so this has to be part of the template's own output -- anything
# added to the generated chezmoi.toml by other means (a one-off --source
# flag, a manual edit) gets silently dropped on the next regeneration.
sourceDir = "{{ .chezmoi.homeDir }}/dotfiles"

[data]
    email = {{ $email | quote }}
    name  = {{ $name | quote }}

[data.apps]
    zsh       = {{ $zsh }}
    git       = {{ $git }}
    vim       = {{ $vim }}
    neovim    = {{ $neovim }}
    lazygit   = {{ $lazygit }}
    yazi      = {{ $yazi }}
    herdr     = {{ $herdr }}
    cli_tools = {{ $cliTools }}
    ghostty   = {{ $ghostty }}
    karabiner = {{ $karabiner }}
