# Loose reference-only files, not managed by chezmoi
*.md
install.sh

# Backing file for dot_claude/symlink_settings.json.tmpl -- holds the
# tracked content; never applied as a target in its own right.
claude_global

# Per-app opt-out -- each app's dotfiles are skipped unless selected during
# `chezmoi init` (see .chezmoi.toml.tmpl / .apps.*). Ghostty and Karabiner
# prompts only fire on darwin, so .apps.ghostty/.apps.karabiner are always
# false on Linux and those two blocks apply there unconditionally.
{{- if not .apps.zsh }}
.zsh
.zshrc
.zshenv
{{- end }}
{{- if not .apps.fish }}
.config/fish
{{- end }}
{{- if not .apps.bash }}
.bash
.bashrc
{{- end }}
{{- if and (not .apps.zsh) (not .apps.fish) }}
.config/starship.toml
{{- end }}
{{- if not .apps.git }}
.gitconfig
{{- end }}
{{- if not .apps.vim }}
.vimrc
{{- end }}
{{- if not .apps.neovim }}
.config/nvim
{{- end }}
{{- if not .apps.lazygit }}
.config/lazygit
{{- end }}
{{- if not .apps.yazi }}
.config/yazi
{{- end }}
{{- if not .apps.herdr }}
.config/herdr
{{- end }}
{{- if not .apps.ghostty }}
.config/ghostty
{{- end }}
{{- if not .apps.karabiner }}
.config/karabiner.edn
{{- end }}
{{- if not .apps.cli_tools }}
.config/bat
.config/eza
{{- end }}
{{- if not .apps.claude }}
.claude
{{- end }}
