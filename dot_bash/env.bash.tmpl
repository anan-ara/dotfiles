# Sourced from the very top of ~/.bashrc (see modify_dot_bashrc), above
# Ubuntu's "not interactive, return" check, so non-interactive
# `ssh host 'cmd'` sessions (e.g. `herdr --remote`) get the same PATH.
# Must stay silent: any output breaks scp/rsync.

{{- if eq .chezmoi.os "darwin" }}
if [ -x /opt/homebrew/bin/brew ]; then
  eval "$(/opt/homebrew/bin/brew shellenv bash)"
elif [ -x /usr/local/bin/brew ]; then
  eval "$(/usr/local/bin/brew shellenv bash)"
fi
{{- else }}
if [ -x /home/linuxbrew/.linuxbrew/bin/brew ]; then
  eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv bash)"
fi
{{- end }}

export XDG_CONFIG_HOME="$HOME/.config"

# Default Apps
{{- if .apps.neovim }}
export EDITOR="nvim"
export VISUAL="nvim"
{{- else if .apps.vim }}
export EDITOR="vim"
export VISUAL="vim"
{{- else }}
export EDITOR="vi"
export VISUAL="vi"
{{- end }}

# Add my scripts
export PATH="$HOME/.local/bin:$PATH"
