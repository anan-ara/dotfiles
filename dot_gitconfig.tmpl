[user]
    name  = {{ .name }}
    email = {{ .email }}
[core]
    excludesfile = {{ .chezmoi.homeDir }}/.gitignore_global
    pager = delta
[init]
    defaultBranch = main
[interactive]
    diffFilter = delta --color-only
[diff]
    algorithm = histogram
[merge]
    conflictStyle = zdiff3
[delta]
    navigate = true
    line-numbers = true
