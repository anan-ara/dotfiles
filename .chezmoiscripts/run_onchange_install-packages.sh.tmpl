#!/bin/bash
# Installs the packages declared in .chezmoidata/packages.yaml for whichever
# apps were selected during `chezmoi init` (see .chezmoi.toml.tmpl / .apps.*).
# Only re-runs when that file's content changes (chezmoi's run_onchange_
# hash), not on every `chezmoi apply`.
set -euo pipefail

{{ $brews := list -}}
{{- $darwinBrews := list -}}
{{- $darwinCasks := list -}}
{{- range $app, $pkgs := .packages -}}
{{- if index $.apps $app -}}
{{/* index (not dot-access) so apps with no brews/darwin_brews/darwin_casks
     key at all (e.g. vim: {}) don't trip chezmoi's missingkey=error */}}
{{- range index $pkgs "brews" -}}{{- $brews = append $brews . -}}{{- end -}}
{{- range index $pkgs "darwin_brews" -}}{{- $darwinBrews = append $darwinBrews . -}}{{- end -}}
{{- range index $pkgs "darwin_casks" -}}{{- $darwinCasks = append $darwinCasks . -}}{{- end -}}
{{- end -}}
{{- end -}}
{{- $brews = $brews | uniq -}}
{{- $darwinBrews = $darwinBrews | uniq -}}
{{- $darwinCasks = $darwinCasks | uniq }}
brews=(
{{- range $brews }}
  "{{ . }}"
{{- end }}
)

{{ if eq .chezmoi.os "darwin" -}}
# --- darwin: Homebrew is the norm here, no confirmation needed ---

darwin_brews=(
{{- range $darwinBrews }}
  "{{ . }}"
{{- end }}
)
darwin_casks=(
{{- range $darwinCasks }}
  "{{ . }}"
{{- end }}
)

if ! command -v brew >/dev/null 2>&1; then
  echo "Installing Homebrew..."
  NONINTERACTIVE=1 /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
fi
eval "$(brew shellenv)"

if ! xcode-select -p >/dev/null 2>&1; then
  echo "Installing Xcode Command Line Tools..."
  xcode-select --install
fi

if [ "${#brews[@]}" -gt 0 ] || [ "${#darwin_brews[@]}" -gt 0 ]; then
  # Either array alone can still be empty here (e.g. only a darwin-only app
  # selected) -- the ${arr[@]+"${arr[@]}"} form expands to nothing for a
  # genuinely empty array under `set -u`, unlike bare "${arr[@]}" which
  # trips "unbound variable" on bash < 4.4 (macOS's stock /bin/bash).
  brew install "${brews[@]+"${brews[@]}"}" "${darwin_brews[@]+"${darwin_brews[@]}"}"
fi
if [ "${#darwin_casks[@]}" -gt 0 ]; then
  brew install --cask "${darwin_casks[@]}"
fi
if [ "${#brews[@]}" -eq 0 ] && [ "${#darwin_brews[@]}" -eq 0 ] && [ "${#darwin_casks[@]}" -eq 0 ]; then
  echo "No apps selected with packages to install."
fi

{{ else if eq .chezmoi.os "linux" -}}
# --- linux ---

# formula name -> binary name, for the few that differ
bin_name() {
  case "$1" in
    git-delta) echo delta ;;
    ripgrep) echo rg ;;
    *) echo "$1" ;;
  esac
}

install_common() {
  if [ "${#brews[@]}" -gt 0 ]; then
    brew install "${brews[@]}"
  else
    echo "No apps selected with packages to install."
  fi
}

if command -v brew >/dev/null 2>&1; then
  install_common
elif [ -d /home/linuxbrew/.linuxbrew ]; then
  eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv)"
  install_common
elif [ "${#brews[@]}" -eq 0 ]; then
  echo "No apps selected with packages to install."
else
  echo "This will install Homebrew (Linuxbrew) to /home/linuxbrew/.linuxbrew,"
  echo "using sudo once, to install: ${brews[*]}"
  printf "Proceed? [y/N] "
  read -r reply
  if [[ "$reply" =~ ^[Yy]$ ]]; then
    if command -v apt-get >/dev/null 2>&1; then
      sudo apt-get update
      sudo apt-get install -y build-essential procps curl file git
    elif command -v dnf >/dev/null 2>&1; then
      sudo dnf group install -y development-tools
      sudo dnf install -y procps-ng curl file git
    elif command -v pacman >/dev/null 2>&1; then
      sudo pacman -Sy --needed --noconfirm base-devel procps-ng curl file git
    else
      echo "Could not detect apt-get/dnf/pacman -- install Homebrew's" >&2
      echo "build prerequisites manually (see docs.brew.sh/Homebrew-on-Linux)" >&2
      echo "and re-run." >&2
      exit 1
    fi

    NONINTERACTIVE=1 /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
    eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv)"
    install_common
  else
    echo "Skipping Homebrew. Checking what's already on \$PATH:"
    echo
    for formula in "${brews[@]}"; do
      case "$formula" in
        zsh-autosuggestions|zsh-syntax-highlighting) continue ;;
      esac
      bin="$(bin_name "$formula")"
      if command -v "$bin" >/dev/null 2>&1; then
        echo "  ok      $formula"
      else
        echo "  missing $formula"
      fi
    done
    echo
    echo "zsh-autosuggestions/zsh-syntax-highlighting aren't standalone"
    echo "binaries -- dot_zsh/plugins.zsh and base.zsh already check the"
    echo "common install paths for these directly."
  fi
fi
{{ end -}}
